<!DOCTYPE html>
<html lang="zh">
<head>
    <title>Client 管理</title>
    {{template "head_common" .}}
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
{{template "navbar" .}}
<section class="section">
    <div class="container">
        <h1 class="title">Client 管理</h1>
        {{if .ErrorMsg}}
        <div class="notification is-danger">{{.ErrorMsg}}</div>
        {{end}}
        <div class="box">
            <form method="post" action="/admin/clients/new">
                <div class="columns">
                    <div class="column">
                        <div class="field">
                            <label class="label">Display Name</label>
                            <div class="control"><input class="input" name="display_name" required></div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Domain</label>
                            <div class="control"><input class="input" name="domain" placeholder="https://example.com"></div>
                        </div>
                    </div>
                </div>
                <div class="columns">
                    <div class="column">
                        <div class="field">
                            <label class="label">Scopes (逗号分隔)</label>
                            <div class="control"><input class="input" name="scopes" placeholder="openid,profile"></div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Token Type</label>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="token_type">
                                        <option value="0">OpaqueToken</option>
                                        <option value="1">JWT</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Secret (可留空自动生成)</label>
                            <div class="control"><input class="input" name="secret" placeholder="auto"></div>
                        </div>
                    </div>
                </div>
                <div class="field has-text-right">
                    <button class="button is-primary" type="submit">创建</button>
                </div>
            </form>
        </div>

        <table class="table is-fullwidth is-striped is-hoverable">
            <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Domain</th>
                <th>Scopes</th>
                <th>TokenType</th>
                <th>创建时间</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {{range .Clients}}
            <tr>
                <td><code>{{.ID}}</code></td>
                <td>{{.DisplayName}}</td>
                <td>{{.Domain}}</td>
                <td>{{range $i,$s := .Scopes}}{{if $i}}, {{end}}{{$s}}{{end}}</td>
                <td>{{.TokenType.String}}</td>
                <td>{{if .CreatedAt}}{{.CreatedAt.Format "2006-01-02 15:04:05"}}{{end}}</td>
                <td>
                    <form method="post" action="/admin/clients/delete" style="display:inline" onsubmit="return confirm('确认删除?')">
                        <input type="hidden" name="id" value="{{.ID}}">
                        <button class="button is-small is-danger" type="submit">删除</button>
                    </form>
                </td>
            </tr>
            {{end}}
            </tbody>
        </table>
    </div>
{{template "footer" .}}
</section>
</body>
</html>
