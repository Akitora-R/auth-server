<!DOCTYPE html>
<html lang="zh">

<head>
    <title>Account 管理</title>
    {{template "head_common" .}}
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body>
    {{template "navbar" .}}
    <main class="layout-main">
        <section class="section">
            <div class="container">
                <h1 class="title">Account 管理</h1>
                {{if .ErrorMsg}}
                <div class="notification is-danger">{{.ErrorMsg}}</div>
                {{end}}
                <div class="box">
                    <form method="post" action="/admin/accounts/new">
                        <div class="columns">
                            <div class="column">
                                <div class="field">
                                    <label class="label">Email</label>
                                    <div class="control"><input class="input" name="email" type="email" required></div>
                                </div>
                            </div>
                            <div class="column">
                                <div class="field">
                                    <label class="label">Display Name</label>
                                    <div class="control"><input class="input" name="display_name" required></div>
                                </div>
                            </div>
                            <div class="column">
                                <div class="field">
                                    <label class="label">Password</label>
                                    <div class="control"><input class="input" name="password" type="password" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="field has-text-right">
                            <button class="button is-primary" type="submit">创建</button>
                        </div>
                    </form>
                </div>

                <table class="table is-fullwidth is-striped is-hoverable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Display Name</th>
                            <th>Roles</th>
                            <th>Last Login</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .Accounts}}
                        <tr>
                            <td><code>{{.ID}}</code></td>
                            <td>{{.Email}}</td>
                            <td>{{.DisplayName}}</td>
                            <td>{{range $i,$r := .Roles}}{{if $i}}, {{end}}{{$r.GetName}}{{end}}</td>
                            <td>{{if .LastLoginAt}}{{.LastLoginAt.Format "2006-01-02 15:04:05"}}{{end}}</td>
                            <td>
                                <form method="post" action="/admin/accounts/delete" style="display:inline"
                                    onsubmit="return confirm('确认删除?')">
                                    <input type="hidden" name="id" value="{{.ID}}">
                                    <button class="button is-small is-danger" type="submit">删除</button>
                                </form>
                            </td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    {{template "footer" .}}
</body>

</html>